@@ -0,0 +1,29 @@
+import importlib.util
+from pathlib import Path
+
+from alembic.migration import MigrationContext
+from alembic.operations import Operations
+import sqlalchemy as sa
+
+
+def test_upgrade_backfills_missing_columns_and_preserves_existing_values():
+    path = Path(__file__).parents[1] / "alembic/versions/20260908_0004_agent_prompt_theme.py"
+    spec = importlib.util.spec_from_file_location("prompt_theme_migration", path)
+    migration = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(migration)
+    engine = sa.create_engine("sqlite://")
+    with engine.begin() as connection:
+        connection.exec_driver_sql("CREATE TABLE agents (id INTEGER PRIMARY KEY)")
+        connection.exec_driver_sql("CREATE TABLE agent_versions (id INTEGER PRIMARY KEY)")
+        connection.exec_driver_sql("INSERT INTO agents (id) VALUES (1)")
+        connection.exec_driver_sql("INSERT INTO agent_versions (id) VALUES (1)")
+        with Operations.context(MigrationContext.configure(connection)):
+            migration.upgrade()
+            assert connection.exec_driver_sql("SELECT theme_key FROM agents").scalar_one() == "default"
+            assert connection.exec_driver_sql("SELECT training_prompt FROM agent_versions").scalar_one() is None
+            connection.exec_driver_sql("UPDATE agents SET theme_key='theme_3'")
+            connection.exec_driver_sql("UPDATE agent_versions SET training_prompt='Keep this exact prompt'")
+            migration.upgrade()
+            assert connection.exec_driver_sql("SELECT theme_key FROM agents").scalar_one() == "theme_3"
+            assert connection.exec_driver_sql("SELECT training_prompt FROM agent_versions").scalar_one() == "Keep this exact prompt"
+    engine.dispose()
