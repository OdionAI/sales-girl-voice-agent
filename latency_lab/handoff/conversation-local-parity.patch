 def utcnow() -> datetime:
     return datetime.now(timezone.utc)
+
+
+def as_utc(value: datetime) -> datetime:
+    # SQLite returns stored UTC timestamps without their timezone information.
+    if value.tzinfo is None:
+        return value.replace(tzinfo=timezone.utc)
+    return value.astimezone(timezone.utc)
diff --git a/tests/test_local_recording.py b/tests/test_local_recording.py
new file mode 100644
index 0000000..9af58af
--- /dev/null
+++ b/tests/test_local_recording.py
@@ -0,0 +1,84 @@
+import uuid
+
+import pytest
+from fastapi import HTTPException
+from app.api.routes_conversations import _local_recording_path
+from app.config.settings import get_settings
+
+
+@pytest.fixture
+def recording_root(tmp_path, monkeypatch):
+    root = tmp_path / "recordings"
+    root.mkdir()
+    monkeypatch.setattr(get_settings(), "local_recording_directory", str(root))
+    return root
+
+
+@pytest.mark.parametrize("url", [
+    "local-recording:///../secret.mp3",
+    "local-recording:///%2e%2e/secret.mp3",
+    "local-recording://remote/secret.mp3",
+    "local-recording:///%00.mp3",
+    "local-recording:///missing.mp3",
+])
+def test_rejects_invalid_paths(recording_root, url):
+    (recording_root.parent / "secret.mp3").write_bytes(b"private")
+    with pytest.raises(HTTPException) as error:
+        _local_recording_path(url, business_id=uuid.uuid4())
+    assert error.value.status_code == 404
+
+
+def test_rejects_symlink_escape(recording_root):
+    secret = recording_root.parent / "secret.mp3"
+    secret.write_bytes(b"private")
+    (recording_root / "link.mp3").symlink_to(secret)
+    with pytest.raises(HTTPException):
+        _local_recording_path("local-recording:///link.mp3", business_id=uuid.uuid4())
+
+
+def test_local_recording_requires_configuration(monkeypatch):
+    monkeypatch.setattr(get_settings(), "local_recording_directory", "")
+    with pytest.raises(HTTPException):
+        _local_recording_path("local-recording:///test.mp3", business_id=uuid.uuid4())
+
+
+def test_authenticated_playback_and_business_isolation(
+    client, service_headers, fake_agent_config_client, recording_root
+):
+    audio = b"ID3-local-test-audio"
+    business_id = service_headers["X-Business-ID"]
+    business_directory = recording_root / "livekit-recordings" / business_id
+    business_directory.mkdir(parents=True)
+    (business_directory / "test.mp3").write_bytes(audio)
+    agent_id = str(uuid.uuid4())
+    fake_agent_config_client.register(agent_id=agent_id, version_id=str(uuid.uuid4()))
+    resolved = client.post("/v1/conversations/resolve", headers=service_headers, json={
+        "agent_id": agent_id, "external_id": "recording@example.com", "channel": "web",
+    })
+    assert resolved.status_code == 200
+    started = client.post("/v1/conversations/sessions/start", headers=service_headers, json={
+        "conversation_id": resolved.json()["conversation_id"], "channel": "web",
+        "client_session_id": "local-recording-test",
+    })
+    assert started.status_code == 201
+    url = f"/v1/conversations/sessions/{started.json()['id']}/recording"
+    assert client.post(url, headers=service_headers, json={
+        "recording_status": "available",
+        "recording_url": f"local-recording:///livekit-recordings/{business_id}/test.mp3",
+    }).status_code == 200
+    response = client.get(url, headers=service_headers)
+    assert response.status_code == 200
+    assert response.content == audio
+    assert response.headers["content-type"].startswith("audio/mpeg")
+    assert "private" in response.headers["cache-control"]
+    assert client.get(url).status_code == 401
+    other_business = {**service_headers, "X-Business-ID": str(uuid.uuid4())}
+    assert client.get(url, headers=other_business).status_code == 404
+
+    other_directory = recording_root / "livekit-recordings" / other_business["X-Business-ID"]
+    other_directory.mkdir()
+    (other_directory / "private.mp3").write_bytes(b"other business audio")
+    assert client.post(url, headers=service_headers, json={
+        "recording_url": f"local-recording:///livekit-recordings/{other_directory.name}/private.mp3",
+    }).status_code == 200
+    assert client.get(url, headers=service_headers).status_code == 404
diff --git a/tests/test_session_timing.py b/tests/test_session_timing.py
new file mode 100644
index 0000000..e834276
--- /dev/null
+++ b/tests/test_session_timing.py
@@ -0,0 +1,65 @@
+from datetime import datetime, timezone
+import uuid
+
+import pytest
+
+
+def _conversation(client, headers, config):
+    agent_id = str(uuid.uuid4())
+    config.register(agent_id=agent_id, version_id=str(uuid.uuid4()))
+    response = client.post("/v1/conversations/resolve", headers=headers, json={
+        "agent_id": agent_id, "external_id": "repeat-caller@example.com", "channel": "web",
+    })
+    assert response.status_code == 200
+    return response.json()["conversation_id"]
+
+
+@pytest.mark.parametrize("timestamp", [None, "2026-09-05T01:01:30+01:00"])
+def test_repeat_call_closes_stale_sqlite_session(
+    client, service_headers, fake_agent_config_client, monkeypatch, timestamp
+):
+    monkeypatch.setattr("app.api.routes_conversations.utcnow", lambda: datetime(
+        2026, 9, 5, 0, 1, 30, tzinfo=timezone.utc
+    ))
+    conversation_id = _conversation(client, service_headers, fake_agent_config_client)
+    payload = {"conversation_id": conversation_id, "channel": "web", "client_session_id": "first"}
+    first = client.post("/v1/conversations/sessions/start", headers=service_headers, json={
+        **payload, "started_at": "2026-09-05T00:00:00Z",
+    })
+    assert first.status_code == 201
+    second_payload = {**payload, "client_session_id": "second"}
+    if timestamp:
+        second_payload["started_at"] = timestamp
+    second = client.post("/v1/conversations/sessions/start", headers=service_headers, json=second_payload)
+    assert second.status_code == 201
+    assert second.json()["id"] != first.json()["id"]
+    previous = client.get(f"/v1/conversations/sessions/{first.json()['id']}", headers=service_headers)
+    assert previous.json()["session"]["status"] == "ended"
+    assert previous.json()["session"]["duration_seconds"] == 90
+    assert second.json()["status"] == "active"
+
+
+@pytest.mark.parametrize("timestamp, duration", [
+    (None, 90), ("2026-09-05T01:01:30+01:00", 90), ("2026-09-04T23:59:00Z", 0),
+])
+def test_end_calculates_duration_for_sqlite_session(
+    client, service_headers, fake_agent_config_client, monkeypatch, timestamp, duration
+):
+    monkeypatch.setattr("app.api.routes_conversations.utcnow", lambda: datetime(
+        2026, 9, 5, 0, 1, 30, tzinfo=timezone.utc
+    ))
+    conversation_id = _conversation(client, service_headers, fake_agent_config_client)
+    started = client.post("/v1/conversations/sessions/start", headers=service_headers, json={
+        "conversation_id": conversation_id, "channel": "web", "client_session_id": "first",
+        "started_at": "2026-09-05T00:00:00Z",
+    })
+    assert started.status_code == 201
+    payload = {"session_id": started.json()["id"]}
+    if timestamp:
+        payload["ended_at"] = timestamp
+    ended = client.post("/v1/conversations/sessions/end", headers=service_headers, json=payload)
+    assert ended.status_code == 200
+    assert ended.json()["duration_seconds"] == duration
+    assert ended.json()["status"] == "ended"
+    retry = client.post("/v1/conversations/sessions/end", headers=service_headers, json=payload)
+    assert retry.json() == ended.json()
