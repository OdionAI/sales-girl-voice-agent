+def _local_recording_path(recording_url: str, *, business_id: uuid.UUID) -> Path:
+    root_value = get_settings().local_recording_directory
+    if not root_value:
+        raise HTTPException(status_code=404, detail="Local recording storage is not enabled.")
+    parsed = urlparse(recording_url)
+    relative_path = unquote(parsed.path).lstrip("/")
+    if parsed.scheme != "local-recording" or parsed.netloc or not relative_path or "\x00" in relative_path:
+        raise HTTPException(status_code=404, detail="Recording file was not found.")
+    root = Path(root_value).resolve()
+    path = (root / relative_path).resolve()
+    if (
+        not path.is_relative_to(root)
+        or path.parent.name != str(business_id)
+        or not path.is_file()
+    ):
+        raise HTTPException(status_code=404, detail="Recording file was not found.")
+    return path
+
