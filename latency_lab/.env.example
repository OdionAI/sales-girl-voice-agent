# All defaults point at the Ascend gateway used by the isolated experiment.
RVC_LAB_STT_WS_URL=ws://102.88.137.124:8080/asr-rt/v1/realtime
RVC_LAB_STT_BATCH_URL=http://102.88.137.124:8080/asr-rt/v1/audio/transcriptions
RVC_LAB_STT_BATCH_TIMEOUT_SECONDS=8
RVC_LAB_STT_MODEL=Qwen3-ASR
# Fault-only path: healthy audio still writes directly to the active socket.
RVC_LAB_STT_RECOVERY_BUFFER_SECONDS=12
RVC_LAB_STT_RECOVERY_MAX_BACKOFF_SECONDS=5
# Keep the healthy Ascend decoder session across turns. Recovery still replaces
# the socket after an actual provider error, unexpected close, or final timeout.
RVC_LAB_STT_ROTATE_AFTER_FINAL=false
RVC_LAB_LLM_BASE_URL=http://102.88.137.124:8080/qwen38/v1
RVC_LAB_LLM_MODEL=qwen3.8-27b
RVC_LAB_LLM_API_KEY=local-npu
RVC_LAB_TTS_URL=http://102.88.137.124:8080/tts/v1/audio/speech
RVC_LAB_TTS_MODEL=Qwen3-TTS
# Stable gateway-cached Helen ICL clone used by the v1 latency baseline.
RVC_LAB_TTS_VOICE=helen-mavino-0030
# Request a playable initial burst instead of the gateway's default 80 ms fragment.
RVC_LAB_TTS_INITIAL_CODEC_CHUNK_FRAMES=16

# Speak once as soon as the LiveKit participant and output track are ready.
RVC_LAB_OPENING_GREETING_ENABLED=true
# Optional fixed override; otherwise the saved agent name is used.
# RVC_LAB_OPENING_GREETING_TEXT=Hello, this is Sarah. How may I help you today?

# Room-scoped agent configuration and attached knowledge retrieval.
# The platform-standard name is preferred. AGENT_CONFIG_API_BASE_URL remains
# available as an experiment-specific override.
AGENT_CONFIG_SERVICE_BASE_URL=http://127.0.0.1:8092
# AGENT_CONFIG_API_BASE_URL=http://127.0.0.1:8092
AGENT_CONFIG_API_TIMEOUT_SECONDS=8
KNOWLEDGE_SERVICE_BASE_URL=http://127.0.0.1:8095
KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=8
AGENT_CLIENT_ID=sales-girl-voice-agent
# AGENT_CONFIG_SERVICE_TOKEN=service-token
# KNOWLEDGE_SERVICE_TOKEN=service-token
# CONVERSATION_SERVICE_TOKEN=shared-fallback-token
CONVERSATION_SERVICE_BASE_URL=http://127.0.0.1:8091
RVC_LAB_ACTION_TOOL_TIMEOUT_SECONDS=12
RVC_LAB_KNOWLEDGE_TOP_K=4

# Optional AICC outbound POC routing. The SIP participant's explicit callee
# header (falling back to SIP From/ANI) selects the saved agent configuration.
# POC_OUTBOUND_BUSINESS_ID=business-uuid
# POC_OUTBOUND_NUMBER_AGENT_MAP={"+2348000000000":{"config_agent_id":"agent-uuid","business_id":"business-uuid","configured_agent_name":"Agent"}}

# Optional: overrides the built-in concise Zenith Bank customer-service prompt.
# RVC_LAB_SYSTEM_PROMPT=You are Helen, a concise Zenith Bank customer-service agent.

# To use a different ICL voice, prefer a gateway-enrolled name so the reference
# is not uploaded and reprocessed on every phrase. A local reference is also
# supported; its transcript must match the spoken audio exactly.
# RVC_LAB_TTS_REF_AUDIO=/absolute/path/to/reference.wav
# RVC_LAB_TTS_REF_TEXT=Exact transcript spoken in reference.wav

RVC_LAB_SPEECH_RMS=280
RVC_LAB_END_SILENCE_MS=300
RVC_LAB_STABLE_PARTIAL_MS=180
RVC_LAB_STABLE_MIN_CHARS=8
