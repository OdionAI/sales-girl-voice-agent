LIVEKIT_URL=wss://livekit-staging.example.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

DEEPGRAM_API_KEY=your_deepgram_api_key
MAAS_API_KEY=your_huawei_maas_api_key
MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
MAAS_LLM_MODEL_DEFAULT=glm-5.2
MAAS_LLM_MODEL_EN=glm-5.2
MAAS_LLM_MODEL_FR=glm-5.2
VOICE_AGENT_LLM_PROVIDER=qwen
QWEN_LLM_BASE_URL=http://102.88.137.124:8080/qwen38-standard/v1
QWEN_LLM_MODEL_DEFAULT=qwen3.8_27b
QWEN_LLM_MODEL_EN=qwen3.8_27b
QWEN_LLM_MODEL_FR=qwen3.8_27b
QWEN_LLM_API_KEY=EMPTY

# LLM provider: qwen for Qwen 3.8 27B with thinking off; maas/google/groq remain alternatives
LLM_PROVIDER=qwen
GROQ_API_KEY=your_groq_api_key
GROQ_LLM_MODEL_DEFAULT=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_LLM_MODEL_EN=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_LLM_MODEL_FR=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_LLM_BACKUP_MODEL_DEFAULT=llama-3.3-70b-versatile
GROQ_LLM_BACKUP_MODEL_EN=llama-3.3-70b-versatile
GROQ_LLM_BACKUP_MODEL_FR=llama-3.3-70b-versatile

GOOGLE_LLM_MODEL_DEFAULT=gemini-3.5-flash-lite
GOOGLE_LLM_MODEL_EN=gemini-3.5-flash-lite
GOOGLE_LLM_MODEL_FR=gemini-3.5-flash-lite
GOOGLE_LLM_BACKUP_MODEL_DEFAULT=gemini-3.1-flash-lite
GOOGLE_LLM_BACKUP_MODEL_EN=gemini-3.1-flash-lite
GOOGLE_LLM_BACKUP_MODEL_FR=gemini-3.1-flash-lite

# Appointments backend service used by tool calls
APPOINTMENTS_API_BASE_URL=http://localhost:8080
APPOINTMENTS_API_TIMEOUT_SECONDS=8

# Agent config backend
AGENT_CONFIG_API_BASE_URL=http://localhost:8092
AGENT_CONFIG_API_TIMEOUT_SECONDS=8

# Knowledge base backend
KNOWLEDGE_SERVICE_BASE_URL=http://localhost:8095
KNOWLEDGE_SERVICE_TOKEN=local-internal-service-token
KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=8

# Multi-tenant metadata tags for tracing headers
AGENT_CLIENT_ID=sales-girl-internal

# Optional Langfuse tracing for agent tool calls
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Conversation persistence (recommended: required mode)
CONVERSATION_API_BASE_URL=http://localhost:8091
CONVERSATION_SERVICE_TOKEN=local-internal-service-token
CONVERSATION_BUSINESS_ID=
CONVERSATION_API_TIMEOUT_SECONDS=8
CONVERSATION_SERVICE_REQUIRED=true
# When CONVERSATION_API_BASE_URL is set, create_ticket POSTs here so tickets appear on the dashboard.
# If unset, internal tickets prefer HOTEL_OPS_SERVICE_BASE_URL (often conversation-service in prod)
# before OPS_SERVICE_BASE_URL so generic agents do not POST dashboard-shaped bodies to demo CRM.

# Optional post-session summary/intent analysis. Analysis runs after the call
# and never blocks transcript, recording, billing, or session completion.
CONVERSATION_ANALYSIS_ENABLED=false
CONVERSATION_ANALYSIS_PROVIDER=maas
CONVERSATION_ANALYSIS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
CONVERSATION_ANALYSIS_MODEL=glm-5.2
CONVERSATION_ANALYSIS_TIMEOUT_SECONDS=15

# Billing service hooks for wallet authorization, live heartbeat charging, and final usage reports
BILLING_HOOK_BASE_URL=http://localhost:8094
BILLING_HOOK_SERVICE_TOKEN=local-internal-service-token
BILLING_HOOK_TIMEOUT_SECONDS=5
BILLING_HEARTBEAT_INTERVAL_SECONDS=10
BILLING_HEARTBEAT_MAX_FAILURES=3
BILLING_FAIL_CLOSED=false

# Demo CRM tool backend
OPS_SERVICE_BASE_URL=http://localhost:8095
OPS_SERVICE_TOKEN=local-internal-service-token

# Hotel internal platform ops backend
HOTEL_OPS_SERVICE_BASE_URL=

# Optional live SIP handoff back into Huawei AICC
AICC_OUTBOUND_TRUNK_NAME=Huawei AICC Outbound Test
AICC_OUTBOUND_TRUNK_ID=
AICC_TEST_ACCESS_CODE=02014114559
AICC_TRANSFER_TARGET_NUMBER=02014114559
AICC_TRANSFER_FROM_NUMBER=02014114559

# Require verified phone identity before starting a call
REQUIRE_VERIFIED_PHONE=true

# Enable the French runtime only when the worker processes are isolated enough
# to avoid LiveKit worker HTTP-port conflicts on the same host.
ENABLE_FRENCH_AGENT=false

# NG TTS consistency defaults for English sessions
ENABLE_ODION_TTS_EN=true
ENABLE_ODION_TTS_FR=true
VOICE_AGENT_STT_PROVIDER=deepgram
VOICE_AGENT_STT_MODEL=nova-3
VOICE_AGENT_STT_INTERIM_RESULTS=true
VOICE_AGENT_STT_ENDPOINTING_MS=300
VOICE_AGENT_STT_NO_DELAY=true
ODION_STT_BASE_URL=https://eu-stt.odion.ai
NG_TTS_BASE_URL=https://tts-ng.odion.ai
NG_TTS_API_KEY=
NG_TTS_REQUEST_TIMEOUT_SECONDS=600
NG_TTS_RETRY_ATTEMPTS=3
NG_TTS_RETRY_BACKOFF_SECONDS=8
# Backward-compatible aliases used by existing saved config/deploy scripts.
ODION_TTS_BASE_URL=https://tts-ng.odion.ai
ODION_TTS_API_KEY=
FORCE_ODION_TTS_EXPERIMENT_VOICE=true
ODION_TTS_EXPERIMENT_OWNER_ID=mavinomichael@gmail.com
ODION_TTS_EXPERIMENT_VOICE_ID=d270a5cec6914373b9deed1d1c3cbade
ODION_TTS_EXPERIMENT_LANGUAGE_HINT=English
ODION_TTS_EXPERIMENT_SEED=0
ODION_TTS_REQUEST_TIMEOUT_SECONDS=600
ODION_TTS_RETRY_ATTEMPTS=3
ODION_TTS_RETRY_BACKOFF_SECONDS=8
STRICT_ODION_CLONE_CONSISTENCY=true

# Turn-taking tuning
# Lower endpointing delays to respond faster after user pauses.
# Increase interruption duration to reduce accidental barge-ins.
TURN_MIN_ENDPOINTING_DELAY=0.25
TURN_MAX_ENDPOINTING_DELAY=0.75
TURN_MIN_INTERRUPTION_DURATION=0.7
VOICE_AGENT_TURN_DETECTOR=v1-mini

# LiveKit recording (required for real conversation audio capture)
LIVEKIT_RECORDING_ENABLED=false
LIVEKIT_RECORDING_STORAGE_PROVIDER=gcs
LIVEKIT_RECORDING_BUCKET=
LIVEKIT_RECORDING_GCS_BUCKET=
LIVEKIT_RECORDING_GCP_CREDENTIALS_JSON=
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET_KEY=
LIVEKIT_RECORDING_S3_SESSION_TOKEN=
LIVEKIT_RECORDING_S3_REGION=af-south-1
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_FORCE_PATH_STYLE=false
LIVEKIT_RECORDING_FILE_PREFIX=livekit-recordings
LIVEKIT_RECORDING_FORMAT=mp3
LIVEKIT_RECORDING_PUBLIC_BASE_URL=
LIVEKIT_RECORDING_POLL_TIMEOUT_SECONDS=45
LIVEKIT_RECORDING_POLL_INTERVAL_SECONDS=2
