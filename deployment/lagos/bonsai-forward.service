[Unit]
Description=Odion isolated Bonsai trial gateway tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -p 29321 -i /root/.ssh/odion-bonsai-durable-gateway -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/odion-voxcpm2-known-hosts -L 127.0.0.1:18143:127.0.0.1:19043 root@102.88.137.124
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
